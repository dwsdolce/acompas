// app global css

body
  font-size 16px
  line-height 1.3em
  min-height 100vh

  .q-page
    height 100%
    box-sizing border-box

body.cordova
  .q-layout
    /* iOS safe area */
    /* iOS 11.0 */
    padding-bottom constant(safe-area-inset-bottom)
    /* iOS 11.2+ */
    padding-bottom env(safe-area-inset-bottom)


.caption
  letter-spacing .2px
  margin-bottom 6px

.q-field__control
  height 42px

.q-btn
  line-height 1.3em
