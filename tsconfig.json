{
  // @quasar/app-vite v2 generates .quasar/tsconfig.json on each build, with
  // the path aliases (src/, components/, layouts/, ...) and compiler defaults.
  // Extend it rather than the package preset, which v2 no longer exports.
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    "strict": true
  }
}
