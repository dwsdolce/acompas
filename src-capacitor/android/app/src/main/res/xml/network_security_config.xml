<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is refused outright.

  Nothing in a shipped build needs it. Capacitor serves the app over its https
  scheme, every asset and audio file is bundled locally, and the one outbound
  request - the Wikipedia extract behind a palo's help - is https, which the
  Content-Security-Policy in index.html independently enforces.

  Debug builds override this file with a permissive one through resource
  merging, because `quasar dev` points the webview at a plain-http dev server.
  See ../../../debug/res/xml/network_security_config.xml.

  This replaced a list of individual addresses inherited from upstream. It
  permitted cleartext to three other developers' machines, and carried three
  entries - 10.0.0.0, 192.168.0.0, 172.16.0.0 - that look like private-range
  wildcards and are not: <domain> matches a hostname or one literal address, and
  includeSubdomains applies to DNS suffixes rather than IP ranges, so each of
  those matched only itself. It could never contain the address of whoever was
  building, which is the only address that would have mattered.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
