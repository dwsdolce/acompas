# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Domains ---
APP_DOMAIN=acompas.org
# The app (web + already-published mobile) tracks to this exact host — see
# src/composables/matomo.ts. Keep it as piwik.acompas.org unless you also
# update that URL in the app and re-release.
MATOMO_DOMAIN=piwik.acompas.org

# --- Let's Encrypt ---
# Used by Let's Encrypt to notify you about certificate expiry / issues.
ACME_EMAIL=you@example.com

# --- Matomo database ---
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
# Use long random strings, e.g. `openssl rand -base64 24`
MATOMO_DB_PASSWORD=change-me-app-password
MATOMO_DB_ROOT_PASSWORD=change-me-root-password

# --- Backups ---
BACKUP_INTERVAL=86400   # seconds between dumps (86400 = daily)
BACKUP_KEEP_DAYS=14     # delete dumps older than this many days
