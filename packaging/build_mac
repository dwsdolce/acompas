#!/bin/zsh
#
# Build the macOS desktop application and a disk image.
#
#   packaging/build_mac            # defaults to dmg
#   packaging/build_mac dmg|app
#   packaging/build_mac help
#
# Produces:
#   dist/electron/Packaged/mac-arm64/Acompas.app
#   dist/electron/Packaged/Acompas-<version>-<arch>.dmg   (unless "app")
#
# Requires the project dependencies to be installed (yarn install), which also
# generates the icons and the audio.
#
# Signing and notarisation are opt-in, because an unsigned build is perfectly
# usable locally and this repository is public - no Developer ID is baked in.
# The settings are read from the same file as the other macOS projects here:
#
#   export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   export APPLE_KEYCHAIN_PROFILE="notarytool-profile"
#   export CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
#   export NOTARY_PROFILE="notarytool-profile"
#
# electron-builder signs the .app with the hardened runtime and notarises and
# staples it. That leaves the disk image itself unstapled, so this script
# notarises and staples the image as well, matching the other ports: the image
# is what a user downloads, and a stapled ticket is what lets Gatekeeper clear
# it without a round trip to Apple.

# Run from the repository root regardless of where this script is invoked from.
cd "$(dirname "$0")/.."

#===============================================
# Electron sanity
#===============================================
# VS Code's plugin host exports ELECTRON_RUN_AS_NODE=1 and every shell it
# spawns inherits it, so a build started from an editor terminal gets it even
# though no dotfile sets it. It makes the Electron binary run as plain Node -
# no app, no BrowserWindow, no window - and the failure reads as a broken
# build: "The requested module 'electron' does not provide an export named
# 'BrowserWindow'", or a silent exit 0. Nothing here ever wants it set.
unset ELECTRON_RUN_AS_NODE

#===============================================
# Signing settings.
#===============================================
# Identity and notary profile live in one file outside every repository, so no
# Developer ID is baked into the source and there is a single place to edit it.
# Absent, the signing steps below detect the unset variables and the build goes
# unsigned - which is the right behaviour for anyone who is not the maintainer.
MACSIGN_ENV="${MACSIGN_ENV:-$HOME/.config/macsign.env}"
[[ -f "$MACSIGN_ENV" ]] && source "$MACSIGN_ENV"

if [[ $# == 0 ]]
then
    format="dmg"
elif [[ $# == 1 ]]
then
    if [[ "$1" == "help" ]]
    then
        echo "build_mac [dmg|app]"
        exit 0
    fi
    format="$1"
    if [[ $format != "dmg" && $format != "app" ]]
    then
        echo "Unknown installer format: $format"
        echo "build_mac [dmg|app]"
        exit 1
    fi
else
    echo "build_mac [dmg|app]"
    exit 1
fi

if ! command -v node >/dev/null 2>&1; then
    echo "node is not on PATH - install the version named in .nvmrc"
    exit 1
fi
if [[ ! -d node_modules ]]; then
    echo "Dependencies are not installed - run: yarn install"
    exit 1
fi

#===============================================
# Hand the credentials to electron-builder under the names it reads
#===============================================
# electron-builder takes the signing identity from CSC_NAME, and notarisation
# credentials from one of three sets of environment variables, tried in this
# order: APPLE_ID/APPLE_APP_SPECIFIC_PASSWORD/APPLE_TEAM_ID, then
# APPLE_API_KEY/APPLE_API_KEY_ID/APPLE_API_ISSUER, then APPLE_KEYCHAIN_PROFILE.
#
# The API key set is a trap for this settings file, because the names collide
# but the meanings do not: electron-builder wants APPLE_API_KEY to be the path
# to the .p8 file and APPLE_API_KEY_ID to be the key id, whereas the file holds
# the id in APPLE_API_KEY and the path in APPLE_API_KEY_PATH. Worse, the check
# fails closed - any one of the three being set makes all three mandatory - so
# passing the file through unaltered aborts the build with "Env vars
# APPLE_API_KEY, APPLE_API_KEY_ID and APPLE_API_ISSUER need to be set" and
# never reaches the keychain profile, which would have worked as it stands.
#
# CSC_NAME also wants the common name on its own: given the full string,
# electron-builder refuses with "Please remove prefix 'Developer ID
# Application:' from the specified name". codesign, used further down for the
# image, takes either form, so only this one is trimmed.
if [[ -n "$APPLE_SIGNING_IDENTITY" ]]; then
    export CSC_NAME="${APPLE_SIGNING_IDENTITY#Developer ID Application: }"
elif [[ -n "$CODESIGN_IDENTITY" ]]; then
    export CSC_NAME="${CODESIGN_IDENTITY#Developer ID Application: }"
fi

if [[ -n "$APPLE_API_KEY_PATH" && -n "$APPLE_API_KEY" && -n "$APPLE_API_ISSUER" ]]; then
    export APPLE_API_KEY_ID="$APPLE_API_KEY"
    export APPLE_API_KEY="$APPLE_API_KEY_PATH"
else
    # Incomplete, so let the keychain profile answer for it instead.
    unset APPLE_API_KEY APPLE_API_KEY_ID APPLE_API_ISSUER
fi

if [[ -z "$CSC_NAME" ]]; then
    echo "No signing identity configured - building unsigned."
else
    echo "Signing as ${CSC_NAME}"
fi

#===============================================
# Clean-up
#===============================================
# Only the packaged output is cleared. node_modules and the generated icons and
# audio are left alone; regenerating them costs minutes and nothing in them
# goes stale between packaging runs.
rm -rf dist/electron

#===============================================
# Build
#===============================================
# quasar.config.js reads CSC_NAME to decide whether to sign and notarise, so
# the two steps above are what turn this from an unsigned build into a signed
# one. electron-builder staples the .app before wrapping it in the image.
yarn quasar build -m electron
if [ $? -ne 0 ]; then
    echo "quasar build -m electron failed"
    exit 1
fi

app=$(ls -d dist/electron/Packaged/*/Acompas.app 2>/dev/null | head -1)
if [[ -z "$app" ]]; then
    echo "No application bundle was produced under dist/electron/Packaged"
    exit 1
fi

if [[ $format == "app" ]]; then
    echo "Built ${app}"
    exit 0
fi

# The image keeps the name electron-builder gave it. Renaming it to the
# Name_V<version> convention used by the other ports would orphan the
# blockmap and latest-mac.yml that are generated beside it and named after it.
installer_name=$(ls dist/electron/Packaged/*.dmg 2>/dev/null | head -1)
if [[ -z "$installer_name" ]]; then
    echo "No disk image was produced under dist/electron/Packaged"
    exit 1
fi

#===============================================
# Sign, notarize and staple the image - all skipped when unconfigured.
#===============================================
if [[ -z "$CODESIGN_IDENTITY" ]]; then
    echo "CODESIGN_IDENTITY is not set - leaving ${installer_name} unsigned."
    echo "Gatekeeper will warn on first launch; right-click > Open to bypass."
    echo "Done creating ${installer_name}"
    exit 0
fi

echo "Signing the ${format}"
# --force because electron-builder has already signed the image it produced and
# codesign refuses an existing signature otherwise ("is already signed").
# Re-signing with the same identity is a no-op in effect and keeps the step
# honest if electron-builder ever stops signing it.
/usr/bin/codesign --force -s "$CODESIGN_IDENTITY" $installer_name
if [ $? -ne 0 ]; then
    echo "Signing the ${format} failed"
    exit 1
fi

if [[ -z "$NOTARY_PROFILE" ]]; then
    echo "NOTARY_PROFILE is not set - skipping notarisation."
    echo "Done creating ${installer_name}"
    exit 0
fi

echo "Notarizing the ${format}"
# notarytool exits 0 when Apple answers, not when Apple approves: a rejected
# submission still returns success and prints "status: Invalid". Checking only
# the exit status therefore carries on to stapling, which fails with a CloudKit
# "Record not found" that says nothing about the real problem. The verdict is
# read out of the output instead, and the log - which names the offending
# binaries - is fetched before giving up.
notary_output=$(xcrun notarytool submit $installer_name --wait --keychain-profile "$NOTARY_PROFILE" 2>&1)
notary_status=$?
echo "$notary_output"
submission_id=$(echo "$notary_output" | awk '/id: /{print $2; exit}')

# Losing the connection while polling is not a failed submission. The upload
# has already happened and Apple keeps processing regardless, so a dropped
# request here - "The request timed out", which is routine on a slow link and
# a large image - used to throw away a build that had in fact been accepted.
# Rejoin the wait instead; notarytool wait prints the same verdict line.
if [ $notary_status -ne 0 ] && [[ -n "$submission_id" ]]; then
    echo "Lost contact while waiting - rejoining submission ${submission_id}"
    notary_output=$(xcrun notarytool wait "$submission_id" --keychain-profile "$NOTARY_PROFILE" 2>&1)
    notary_status=$?
    echo "$notary_output"
fi

if [ $notary_status -ne 0 ]; then
    echo "Notarizing the ${format} failed"
    if [[ -n "$submission_id" ]]; then
        echo "The submission may still be processing. Check it with:"
        echo "  xcrun notarytool info $submission_id --keychain-profile $NOTARY_PROFILE"
        echo "and if it was accepted, staple without rebuilding:"
        echo "  xcrun stapler staple $installer_name"
    fi
    exit 1
fi
if ! echo "$notary_output" | grep -q "status: Accepted"; then
    echo "Notarisation did not succeed - fetching the log"
    if [[ -n "$submission_id" ]]; then
        xcrun notarytool log "$submission_id" --keychain-profile "$NOTARY_PROFILE"
    fi
    exit 1
fi

echo "Stapling the ${format}"
xcrun stapler staple $installer_name
if [ $? -ne 0 ]; then
    echo "Stapling the ${format} failed"
    exit 1
fi

echo "Done creating ${installer_name}"
