.DS_Store
.thumbs.db
node_modules

# Quasar core related directories
.quasar
/dist

# Cordova related directories and files
/src-cordova/node_modules
/src-cordova/platforms
/src-cordova/plugins
/src-cordova/www

# Palmas specific ignores
# Generated icons. `yarn icons` produces these from resources/icon.png, and the
# postinstall hook runs it, so a fresh clone is build-ready with no manual
# step. Do not commit them.
#
# `yarn icons:all` is a different, occasional job: it runs the full profile,
# which also rewrites the Capacitor Android and iOS assets that ARE committed,
# and flattens the iOS icon, which Icon Genie writes with an alpha channel that
# App Store Connect refuses. Run it only when the source icon changes, and
# review the diff.
/public/favicon.ico
/public/icons
/src-electron/electron-assets
# Every playable file is generated from the .wav masters in audio/, which are
# the committed ones. The whole directory goes, rather than a list of formats
# that had to grow whenever one was added or dropped.
/public/audio/

# Capacitor related directories and files
/src-capacitor/www
/src-capacitor/node_modules

# Electron related directories and files
# (Electron's generated icons are covered by the icon rules further up.)

# BEX related directories and files
/src-bex/www
/src-bex/js/core

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
.claude

out/

# Secrets & signing material (never commit) — global safety net
*.jks
*.keystore
*.apks
*.apk
*.aab
*.p12
*.pem
keystore.properties
google-services.json

# Playwright output
/test-results
/playwright-report

# Scratch space. Kept ignored rather than removed with the directory it was
# added for: a /tmp is the obvious place to drop a working file, and it should
# stay impossible to commit one by accident. Artwork sources that are worth
# keeping live in resources/artwork, which is versioned.
/tmp/
