.DS_Store
.thumbs.db
node_modules

# Quasar core related directories
.quasar
/dist

# Cordova related directories and files
/src-cordova/node_modules
/src-cordova/platforms
/src-cordova/plugins
/src-cordova/www

# Palmas specific ignores
# Generated icons, all of them derived from resources/artwork/logo.svg.
# scripts/icons.mjs renders the 1024px master and then produces whatever the
# target being built needs, and the build asks it first, so there is nothing to
# run by hand and no way to ship an icon older than the artwork.
#
# The master is generated too. It used to be exported from the drawing by hand
# and committed, which made it the one place the chain could silently fall
# behind its source.
/resources/icon.png
/public/favicon.ico
/public/icons
/src-electron/electron-assets
# What the icons were generated from, so a build can tell whether they are still
# current without regenerating them to find out.
/.icons/

# The Capacitor native projects are committed - they are real Xcode and Gradle
# projects - but the images inside them are not: they are generated from
# resources/icon.png like every other icon, and were only ever in git because
# they arrived with the project scaffold in 2022.
#
# Named file by file rather than by directory, because these sit beside things
# that genuinely are sources: ic_launcher_background.png, which nothing derives
# from the artwork, and the asset catalogue's Contents.json.
/src-capacitor/android/app/src/main/res/mipmap-*/ic_launcher.png
/src-capacitor/android/app/src/main/res/mipmap-*/ic_launcher_round.png
/src-capacitor/android/app/src/main/res/mipmap-*/ic_launcher_foreground.png
/src-capacitor/android/app/src/main/res/drawable*/launch_splash.png
/src-capacitor/ios/App/App/Assets.xcassets/AppIcon.appiconset/*.png
/src-capacitor/ios/App/App/Assets.xcassets/Splash.imageset/*.png
# Every playable file is generated from the .wav masters in audio/, which are
# the committed ones. The whole directory goes, rather than a list of formats
# that had to grow whenever one was added or dropped.
/public/audio/

# Capacitor related directories and files
/src-capacitor/www
/src-capacitor/node_modules

# Electron related directories and files
# (Electron's generated icons are covered by the icon rules further up.)

# BEX related directories and files
/src-bex/www
/src-bex/js/core

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
.claude

out/

# Secrets & signing material (never commit) — global safety net
*.jks
*.keystore
*.apks
*.apk
*.aab
*.p12
*.pem
keystore.properties
google-services.json

# Playwright output
/test-results
/playwright-report

# Scratch space. Kept ignored rather than removed with the directory it was
# added for: a /tmp is the obvious place to drop a working file, and it should
# stay impossible to commit one by accident. Artwork sources that are worth
# keeping live in resources/artwork, which is versioned.
/tmp/
